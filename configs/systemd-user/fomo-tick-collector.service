[Unit]
Description=fomo tick collector — les prix 24/7 de tous les tokens visibles
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/run/media/cheurteen/Jeux SSD/trading-agent
ExecStart="/run/media/cheurteen/Jeux SSD/trading-agent/.venv/bin/python" -u scripts/fomo_tick_collector.py
Restart=always
RestartSec=30
StandardOutput=journal

[Install]
WantedBy=default.target
