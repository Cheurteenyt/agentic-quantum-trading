# Core Equity private access
# Generate a strong value, then copy it into backend/.env.
CORE_ACCESS_TOKEN=replace-with-a-long-random-client-token
# Separate admin token for data mutations. Do not give this to clients.
CORE_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token
CORE_REQUIRE_LOCAL_AUTH=true

# Replace with the hostname created by Cloudflare Access or Tailscale Serve.
CORE_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,core-equity.example.com
CORE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://core-equity.example.com

# Tailscale alternative without domain:
# CORE_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,100.x.y.z
# CORE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://100.x.y.z:8000

# Legacy HERMES_* variables are still accepted as fallback only.

# On-chain RPC ingestion
# Public RPCs work for light tests, but serious Arkham-style coverage needs private RPC endpoints.
HERMES_RPC_ETHEREUM=https://rpc.flashbots.net
HERMES_RPC_ETHEREUM_FALLBACKS=https://eth.llamarpc.com,https://ethereum.publicnode.com
HERMES_RPC_BSC=https://bsc-dataseed.binance.org/
HERMES_RPC_BSC_FALLBACKS=https://bsc.publicnode.com,https://bsc-dataseed1.binance.org/
HERMES_RPC_SOLANA=https://api.mainnet-beta.solana.com
HERMES_ONCHAIN_MAX_TX_PER_BLOCK=200
