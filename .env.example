# API Keys
TRADING_API_KEY=your_trading_api_key_here
TRADING_API_SECRET=your_trading_api_secret_here
CCXT_API_KEY=your_ccxt_api_key
CCXT_API_SECRET=your_ccxt_api_secret

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/trading_db
REDIS_URL=redis://localhost:6379

# Model Provider — legacy agent (ollama/qwen absents d'omarchy depuis 2026-09)
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5

# Gateway (optional)
# TELEGRAM_BOT_TOKEN=your_bot_token
# GATEWAY_PORT=8000

# Discord (rapports de campagne) — à configurer
# DISCORD_BOT_TOKEN=your_discord_bot_token
# DISCORD_HOME_CHANNEL=your_channel_id

# Core Equity private access
CORE_ACCESS_TOKEN=replace-with-a-long-random-client-token
# Admin-only token for labels/RPC ingestion endpoints. Never share with clients.
CORE_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token

# Core Equity on-chain RPC ingestion
HERMES_RPC_ETHEREUM=https://rpc.flashbots.net
HERMES_RPC_ETHEREUM_FALLBACKS=https://eth.llamarpc.com,https://ethereum.publicnode.com
HERMES_RPC_BSC=https://bsc-dataseed.binance.org/
HERMES_RPC_BSC_FALLBACKS=https://bsc.publicnode.com,https://bsc-dataseed1.binance.org/
HERMES_RPC_SOLANA=https://api.mainnet-beta.solana.com
HERMES_ONCHAIN_MAX_TX_PER_BLOCK=200

# Core Equity automatic labelled-wallet RPC enrichment
# Safe default: priority queue only, skips entities without verified labels, audited in data_jobs.
CORE_AUTO_ENRICH_ENABLED=true
CORE_AUTO_ENRICH_INTERVAL_SECONDS=3600
CORE_AUTO_ENRICH_LIMIT_PER_ENTITY=10
CORE_AUTO_ENRICH_MAX_ENTITIES=4
CORE_AUTO_ENRICH_MIN_CONFIDENCE=medium
CORE_AUTO_ENRICH_INCLUDE_TOKENS=true
CORE_AUTO_LABEL_BUILD_ENABLED=true
CORE_AUTO_LABEL_BUILD_LIMIT_FILES=

# Core Equity Supabase-ready storage (disabled until schema/RLS are reviewed)
# Keep service role server-side only. Never expose it in frontend or client docs.
SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-key-only-if-needed
SUPABASE_SERVICE_ROLE_KEY=server-side-only-never-share
CORE_SUPABASE_WRITE_MODE=dry_run

# Discord bot (voir discord/README.md)
DISCORD_BOT_TOKEN=ton_token_de_bot_ici
DISCORD_GUILD_ID=l_id_de_ton_serveur_ici
DISCORD_HOME_CHANNEL=l_id_du_salon_des_rapports_ici

# Le salon de log de modération (optionnel — sinon un salon nommé logs est détecté)
# DISCORD_MOD_LOG_CHANNEL=l_id_du_salon_logs
