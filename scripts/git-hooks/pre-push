#!/bin/bash
# Bloque les pushs directs sur main — tout passe par une PR.
while read local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo ""
        echo "🚫 BLOCKED : les pushs directs sur main sont interdits."
        echo "   Crée une branche, pousse-la, puis ouvre une PR :"
        echo "   git checkout -b feat/... && git push -u origin feat/... && gh pr create"
        echo ""
        exit 1
    fi
done
exit 0
